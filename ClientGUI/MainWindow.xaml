<Window x:Class="ClientGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTP Client" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель подключения -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10">
            <StackPanel>
                <TextBlock Text="FTP CLIENT" FontSize="18" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" 
                              Foreground="White" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtServer" Text="127.0.0.1" 
                            VerticalAlignment="Center" Padding="5" Margin="0,0,20,0"/>

                    <TextBlock Grid.Column="2" Text="Порт:" VerticalAlignment="Center" 
                              Foreground="White" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="3" x:Name="TxtPort" Text="8888" 
                            VerticalAlignment="Center" Padding="5" Margin="0,0,20,0"/>

                    <Button Grid.Column="4" x:Name="BtnConnect" Content="Подключиться" 
                           Width="120" Height="30" Click="BtnConnect_Click"
                           Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Панель авторизации -->
        <Border Grid.Row="1" x:Name="PanelAuth" Background="#F5F5F5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Логин:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="TxtLogin" VerticalAlignment="Center" 
                        Padding="5" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="Пароль:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <PasswordBox Grid.Column="3" x:Name="TxtPassword" VerticalAlignment="Center" 
                            Padding="5" Margin="0,0,20,0"/>

                <Button Grid.Column="4" x:Name="BtnLogin" Content="Войти" 
                       Width="100" Height="30" Click="BtnLogin_Click"
                       Background="#2196F3" Foreground="White" Margin="0,0,10,0"/>

                <Button Grid.Column="5" x:Name="BtnRegister" Content="Регистрация" 
                       Width="100" Height="30" Click="BtnRegister_Click"
                       Background="#FF9800" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Основная панель -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель инструментов -->
            <Border Grid.Row="0" Background="#E0E0E0" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtCurrentPath" Text="Путь: не подключен" 
                              VerticalAlignment="Center" FontWeight="Bold"/>

                    <Button Grid.Column="1" x:Name="BtnRefresh" Content="🔄 Обновить" 
                           Width="100" Height="30" Click="BtnRefresh_Click" Margin="0,0,10,0"/>

                    <Button Grid.Column="2" x:Name="BtnUpload" Content="⬆ Загрузить" 
                           Width="100" Height="30" Click="BtnUpload_Click" Margin="0,0,10,0"/>

                    <Button Grid.Column="3" x:Name="BtnHistory" Content="📜 История" 
                           Width="100" Height="30" Click="BtnHistory_Click"/>
                </Grid>
            </Border>

            <!-- Список файлов -->
            <ListView Grid.Row="1" x:Name="ListViewFiles" 
         MouseDoubleClick="ListViewFiles_DoubleClick"
         Background="White" BorderBrush="#BDBDBD" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" Width="400" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="Тип" Width="150" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Действие" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="⬇ Скачать" Width="90" Height="25" 
                                   Tag="{Binding Name}" Click="BtnDownload_Click" Margin="0,0,5,0"
                                   Visibility="{Binding DownloadVisible}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

        </Grid>

        <!-- Статус-бар -->
        <Border Grid.Row="3" Background="#424242" Padding="10">
            <TextBlock x:Name="TxtStatus" Text="Готов к работе" 
                      Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>
